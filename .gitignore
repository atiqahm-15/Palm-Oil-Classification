# Datasets (raw + derived images only — data/README.md and manifests stay tracked)
dataset/
data/raw/
# Ignore the derived image trees, but keep the split manifests — they define every
# train/valid/test and LODO fold and are required to reproduce any run.
data/processed/*
!data/processed/*.csv
!data/processed/lodo/
data/processed/lodo/*
!data/processed/lodo/*.csv

# Model Checkpoints and Weights
models/
*.keras
*.h5
*.hdf5
*.ckpt
*.cp
# TFLite exports are derived weights like the rest — regenerate with
# src/training/export_tflite.py rather than committing ~30MB per model per mode.
*.tflite

# Python Caches
__pycache__/
*.pyc
.ipynb_checkpoints/

# Virtual Environments
venv/
env/
.env

# Mobile App Exports (Uncomment if you want to ignore TFLite)
exports/

# IDE and OS files
.vscode/
.idea/
.DS_Store
Thumbs.db

# App test fixtures copied from the test split — images and their tensors stay out of git
# like the rest of the dataset. reference.json (numbers only) stays tracked. Regenerate with
# src/training/make_app_bundle.py.
app/src/androidTest/assets/fixtures/*
!app/src/androidTest/assets/fixtures/reference.json

# Same split for the device latency sweep: the staged quantization variants are covered by the
# *.tflite rule above, and benchmark/manifest.json (sizes, hashes, host latencies) stays tracked.

# Android build outputs and machine-local paths. The wrapper itself (gradlew, gradlew.bat,
# gradle/wrapper/) stays tracked so the APK builds from a fresh clone.
.gradle/
build/
app/build/
local.properties
*.iml
captures/
.cxx/
app/release/
